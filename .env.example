# Copie pra Vercel → Project → Settings → Environment Variables
# (não comite o .env real)

# String que VOCÊ inventa. A MESMA vai no campo "Verificar token" do Meta.
IG_VERIFY_TOKEN=watagent_verify_8x2k

# Token long-lived da conta IG (gerado no passo 2 do Meta, depois trocado por 60 dias)
IG_ACCESS_TOKEN=

# "Chave secreta do app do Instagram" (botão Mostrar no painel do Meta)
IG_APP_SECRET=

# Opcional: só responde comentários que contenham essa palavra. Vazio = responde todos.
IG_TRIGGER_WORD=quero

# Texto do DM automático
IG_REPLY_TEXT=Oi! Vi seu comentário 🙌 te mandei o link aqui no direct.

# Resposta pública no próprio comentário. Vazio = não responde publicamente.
IG_PUBLIC_REPLY_TEXT=Te chamei no direct! 📩
