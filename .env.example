# Copie pra Vercel → Project → Settings → Environment Variables
# (não comite o .env real)
#
# Todos os tokens: tipo "Encrypted", NUNCA "Sensitive" — o cron
# refresh-token.mjs precisa LER o valor de volta pra renovar, e "Sensitive"
# não deixa ler.

# ── Do APP (valem pra todas as contas) ───────────────────────────────────

# String que VOCÊ inventa. A MESMA vai no campo "Verificar token" do Meta.
IG_VERIFY_TOKEN=

# "Chave secreta do app do Instagram" (botão Mostrar no painel do Meta)
IG_APP_SECRET=

# ── Por conta (o nome de cada um está em api/contas.js, campo tokenEnv) ──

# @watanabe.ia — user_id 17841400866194604
IG_ACCESS_TOKEN=

# @eternizacards — user_id 17841438494434121
IG_ACCESS_TOKEN_ETERNIZA=
